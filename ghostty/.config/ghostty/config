background = 000000
foreground = ffffff

font-family = Terminus (TTF)
font-size = 18

window-padding-x = 8
window-padding-y = 8

cursor-style = block

mouse-hide-while-typing = true

shell-integration = zsh
command = /usr/bin/zsh

confirm-close-surface = false

copy-on-select = false

scrollback-limit = 100000

window-save-state = always
